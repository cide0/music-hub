<!DOCTYPE html>
<html lang="en" class="is-logged-out">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/navbar') %>

    <main class="page">
      <h1 class="page__title"><%= pageTitle %></h1>

      <!-- Shown once a valid Spotify login is present. -->
      <section class="page__content settings" data-auth-required>
        <section class="settings-section" aria-labelledby="settings-data-title">
          <h2 class="settings-section__title" id="settings-data-title">Data</h2>
          <p class="settings-section__text">
            Everything Music Hub saves lives in this browser only. Export it to a file
            to back it up or move it to another device, then import that file there.
            Importing replaces the data currently stored here. Spotify and Google logins
            aren't included.
          </p>
          <div class="settings-section__actions">
            <button type="button" class="button button--ghost" id="export-data">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              Export data
            </button>
            <button type="button" class="button button--ghost" id="import-data">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" />
              </svg>
              Import data
            </button>
            <input type="file" id="import-file" accept="application/json,.json" hidden />
            <button type="button" class="button button--ghost settings-section__action-end" id="clear-all-data">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" />
              </svg>
              Clear all data
            </button>
          </div>
        </section>

        <section class="settings-section" aria-labelledby="settings-google-title">
          <h2 class="settings-section__title settings-section__title--icon" id="settings-google-title">
            <svg class="google-logo" viewBox="0 0 48 48" aria-hidden="true">
              <path class="google-logo__red" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
              <path class="google-logo__blue" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
              <path class="google-logo__yellow" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
              <path class="google-logo__green" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
            </svg>
            Google
          </h2>
          <p class="settings-section__text">
            Used to add concerts to your Google Calendar from the Concerts page.
          </p>
          <div class="settings-section__actions settings-account">
            <p class="settings-account__status" id="google-status">
              <span class="settings-account__dot" aria-hidden="true"></span>
              <span id="google-status-text">Not logged in</span>
            </p>
            <button type="button" class="button button--primary" id="google-login" hidden>Login with Google</button>
            <button type="button" class="button button--ghost" id="google-logout" hidden>Log out</button>
          </div>
        </section>

        <section class="settings-section" aria-labelledby="settings-setlist-title">
          <h2 class="settings-section__title" id="settings-setlist-title">Setlists</h2>
          <p class="settings-section__text">
            The playlist that's already selected when you open a setlist. You can still
            pick a different one there.
          </p>
          <p class="form-message settings-section__message" id="default-playlist-message" hidden></p>
          <div class="settings-section__actions">
            <!-- Same dropdown as on the Setlists page (playlist-picker.js). -->
            <div class="playlist-picker" id="default-playlist-picker" hidden>
              <span class="visually-hidden" id="default-playlist-label">Default playlist</span>
              <button type="button" class="playlist-picker__toggle"
                aria-haspopup="listbox" aria-expanded="false" aria-labelledby="default-playlist-label default-playlist-current">
                <span class="playlist-picker__current" id="default-playlist-current">No default playlist</span>
              </button>
              <ul class="playlist-picker__list" role="listbox" tabindex="-1"
                aria-labelledby="default-playlist-label" hidden></ul>
            </div>
            <button type="button" class="button button--ghost" id="default-playlist-clear" hidden>Remove default</button>
          </div>
          <p class="form-message" id="default-playlist-saved" role="status" hidden></p>
        </section>

        <section class="settings-section" aria-labelledby="settings-discogs-title">
          <h2 class="settings-section__title" id="settings-discogs-title">Discogs</h2>
          <p class="settings-section__text">
            Your Discogs username, for the Pick of the Day from your collection and the link
            to it on the Discogs page. Your collection needs to be public on Discogs.
          </p>
          <form class="inline-form" id="discogs-username-form" novalidate>
            <label class="visually-hidden" for="discogs-username">Discogs username</label>
            <input type="text" class="text-input" id="discogs-username" name="discogs-username"
              placeholder="Discogs username" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="200" />
            <button type="submit" class="button button--ghost">Save</button>
            <button type="button" class="button button--ghost" id="discogs-username-clear" hidden>Remove</button>
          </form>
          <p class="form-error" id="discogs-username-error" role="alert" hidden></p>
          <p class="form-message" id="discogs-username-saved" role="status" hidden></p>
        </section>
      </section>

      <!-- Page-level gating: no Spotify login, no page content. -->
      <section class="empty-state" data-auth-missing>
        <p>Please log in to Spotify first</p>
      </section>
    </main>

    <script src="/js/storage.js"></script>
    <script src="/js/navbar.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/wallet.js"></script>
    <script src="/js/google.js"></script>
    <script src="/js/spotify.js"></script>
    <script src="/js/playlist-picker.js"></script>
    <script src="/js/confirm-dialog.js"></script>
    <script src="/js/settings.js"></script>
  </body>
</html>
