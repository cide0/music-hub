<!DOCTYPE html>
<html lang="en" class="is-logged-out">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/navbar') %>

    <main class="page">
      <h1 class="page__title"><%= pageTitle %></h1>

      <!-- Shown once a valid Spotify login is present. -->
      <section class="page__content settings" data-auth-required>
        <section class="settings-section" aria-labelledby="settings-data-title">
          <h2 class="settings-section__title" id="settings-data-title">Data</h2>
          <p class="settings-section__text">
            Everything Music Hub saves lives in this browser, and with Google Drive sync
            turned on also in your Google Drive. Export it to a file to back it up or move
            it to another device, then import that file there. Importing replaces the data
            currently stored here. Spotify and Google logins aren't included.
          </p>
          <div class="settings-section__actions">
            <button type="button" class="button button--ghost" id="export-data">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              Export data
            </button>
            <button type="button" class="button button--ghost" id="import-data">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" />
              </svg>
              Import data
            </button>
            <input type="file" id="import-file" accept="application/json,.json" hidden />
            <button type="button" class="button button--danger settings-section__action-end" id="clear-all-data">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" />
              </svg>
              Clear all data
            </button>
          </div>
          <div class="notice notice--error settings-section__notice" id="import-error" role="alert" hidden></div>
        </section>

        <section class="settings-section" aria-labelledby="settings-sounds-title">
          <h2 class="settings-section__title" id="settings-sounds-title">Sounds</h2>
          <div class="settings-switches">
            <label class="switch">
              <input type="checkbox" id="sound-effects" checked />
              <span class="switch__track"><span class="switch__thumb"></span></span>
              <span class="switch__label">Sound effects</span>
            </label>
            <label class="switch">
              <input type="checkbox" id="listen-coin-sound" checked />
              <span class="switch__track"><span class="switch__thumb"></span></span>
              <span class="switch__label">Coin sound while playing an album</span>
            </label>
          </div>
        </section>

        <section class="settings-section" aria-labelledby="settings-google-title">
          <h2 class="settings-section__title settings-section__title--icon" id="settings-google-title">
            <svg class="google-logo" viewBox="0 0 48 48" aria-hidden="true">
              <path class="google-logo__red" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
              <path class="google-logo__blue" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
              <path class="google-logo__yellow" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
              <path class="google-logo__green" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
            </svg>
            Google
          </h2>
          <p class="settings-section__text">
            Used to add concerts to your Google Calendar from the Concerts page, for the
            Google Drive sync and for filling the Gallery from a Drive folder.
          </p>
          <div class="settings-section__actions settings-account">
            <p class="settings-account__status" id="google-status">
              <span class="settings-account__dot" aria-hidden="true"></span>
              <span id="google-status-text">Not logged in</span>
            </p>
            <button type="button" class="button button--ghost" id="google-login" hidden>Login with Google</button>
            <button type="button" class="button button--ghost" id="google-logout" hidden>Log out</button>
          </div>

          <div class="settings-subsection" role="group" aria-labelledby="settings-sync-title">
            <h3 class="settings-subsection__title" id="settings-sync-title">Google Drive sync</h3>
            <p class="settings-section__text">
              Keeps your Music Hub data the same in every browser where sync is on. Each
              change is saved to a hidden Music Hub folder in your Google Drive, and every
              page picks up the changes from your other devices when it opens. Where two
              devices changed the same data, the newer change wins.
            </p>
            <div class="settings-section__actions settings-account">
              <p class="settings-account__status" id="sync-status">
                <span class="settings-account__dot" aria-hidden="true"></span>
                <span id="sync-status-text">Off</span>
              </p>
              <button type="button" class="button button--ghost" id="sync-enable" hidden>Turn on sync</button>
              <button type="button" class="button button--ghost" id="sync-now" hidden>Sync now</button>
              <button type="button" class="button button--ghost" id="sync-disable" hidden>Turn off</button>
            </div>
            <p class="form-error settings-sync__error" id="sync-error" role="alert" hidden></p>
          </div>

          <div class="settings-subsection" role="group" aria-labelledby="settings-gallery-folder-title">
            <h3 class="settings-subsection__title" id="settings-gallery-folder-title">Gallery folder</h3>
            <p class="settings-section__text">
              The Gallery fills itself from this Google Drive folder: inside it one folder per
              artist, named like the artist, in those one folder per concert, and in those the
              images and videos. Leave it empty to use the folder called &ldquo;Concerts&rdquo; at
              the top of your My Drive.
            </p>
            <form class="inline-form" id="gallery-folder-form" novalidate>
              <label class="visually-hidden" for="gallery-folder">Google Drive folder link</label>
              <input type="text" class="text-input" id="gallery-folder" name="gallery-folder"
                placeholder="Folder link (default: Concerts)" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="500" />
              <button type="submit" class="button button--ghost">Save</button>
              <button type="button" class="button button--ghost" id="gallery-folder-clear" hidden>Remove</button>
            </form>
            <p class="form-error" id="gallery-folder-error" role="alert" hidden></p>
            <p class="form-message" id="gallery-folder-saved" role="status" hidden></p>
          </div>
        </section>

        <section class="settings-section" aria-labelledby="settings-playlists-title">
          <h2 class="settings-section__title" id="settings-playlists-title">Spotify playlists</h2>
          <p class="settings-section__text">
            Music Hub keeps a copy of your playlists here and only asks Spotify for them when
            you refresh, so after creating or renaming a playlist on Spotify, refresh them here.
          </p>
          <div class="settings-section__actions settings-account">
            <button type="button" class="icon-button refresh-button" id="playlists-refresh" aria-label="Fetch your playlists from Spotify" title="Fetch your playlists from Spotify">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="23 4 23 10 17 10" /><polyline points="1 20 1 14 7 14" />
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
              </svg>
            </button>
            <span class="toolbar__meta" id="playlists-meta">Not fetched yet</span>
          </div>
          <p class="form-error" id="playlists-error" role="alert" hidden></p>
          <p class="form-message" id="playlists-saved" role="status" hidden></p>

          <div class="settings-subsection" role="group" aria-labelledby="settings-setlist-title">
            <h3 class="settings-subsection__title" id="settings-setlist-title">Setlists</h3>
            <p class="settings-section__text">
              The playlist that's already selected when you open a setlist. You can still
              pick a different one there.
            </p>
            <p class="form-message settings-section__message" id="default-playlist-message" hidden></p>
            <div class="settings-section__actions">
              <!-- Same dropdown as on the Setlists page (playlist-picker.js). -->
              <div class="playlist-picker" id="default-playlist-picker" hidden>
                <span class="visually-hidden" id="default-playlist-label">Default playlist</span>
                <button type="button" class="playlist-picker__toggle"
                  aria-haspopup="listbox" aria-expanded="false" aria-labelledby="default-playlist-label default-playlist-current">
                  <span class="playlist-picker__current" id="default-playlist-current">No default playlist</span>
                </button>
                <ul class="playlist-picker__list" role="listbox" tabindex="-1"
                  aria-labelledby="default-playlist-label" hidden></ul>
              </div>
              <button type="button" class="button button--ghost" id="default-playlist-clear" hidden>Remove default</button>
            </div>
            <p class="form-message" id="default-playlist-saved" role="status" hidden></p>
          </div>

          <div class="settings-subsection" role="group" aria-labelledby="settings-collection-title">
            <h3 class="settings-subsection__title" id="settings-collection-title">Collection</h3>
            <p class="settings-section__text">
              The playlists the record player's + puts the playing song on. Pick as many as you
              like; you can add it to others from the player too.
            </p>
            <p class="settings-section__text">
              <strong>Rotation playlists</strong> keep only your newest songs. Switch one on beside a
              ticked playlist and choose how many songs it keeps - say 10. Until it holds 10 songs,
              a new song is simply added. Once it's full, every new song pushes out the one that has
              been on the playlist the longest, so it always holds your latest 10.
            </p>
            <p class="form-message settings-section__message" id="collection-playlists-message" hidden></p>
            <div class="playlist-checklist-wrap" id="collection-playlists-wrap" hidden>
              <ul class="playlist-checklist" id="collection-playlists" aria-label="Playlists for the record player's +"></ul>
            </div>
            <p class="form-error" id="collection-playlists-error" role="alert" hidden></p>
            <p class="form-message" id="collection-playlists-saved" role="status" hidden></p>
          </div>
        </section>

        <section class="settings-section" aria-labelledby="settings-discogs-title">
          <h2 class="settings-section__title" id="settings-discogs-title">Discogs</h2>
          <p class="settings-section__text">
            Your Discogs username, for the Pick of the Day from your collection and the link
            to it on the Discogs page. Your collection needs to be public on Discogs.
          </p>
          <form class="inline-form" id="discogs-username-form" novalidate>
            <label class="visually-hidden" for="discogs-username">Discogs username</label>
            <input type="text" class="text-input" id="discogs-username" name="discogs-username"
              placeholder="Discogs username" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="200" />
            <button type="submit" class="button button--ghost">Save</button>
            <button type="button" class="button button--ghost" id="discogs-username-clear" hidden>Remove</button>
          </form>
          <p class="form-error" id="discogs-username-error" role="alert" hidden></p>
          <p class="form-message" id="discogs-username-saved" role="status" hidden></p>
        </section>
      </section>

      <!-- Page-level gating: no Spotify login, no page content. -->
      <section class="empty-state" data-auth-missing>
        <p>Please log in to Spotify first</p>
      </section>
    </main>

    <script src="/js/notice.js"></script>
    <script src="/js/storage.js"></script>
    <script src="/js/google.js"></script>
    <script src="/js/sync.js"></script>
    <script src="/js/navbar.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/followed-artists.js"></script>
    <script src="/js/wallet.js"></script>
    <script src="/js/vinyl.js"></script>
    <script src="/js/vinyl-catalog.js"></script>
    <script src="/js/sfx.js"></script>
    <script src="/js/unbox.js"></script>
    <script src="/js/daily-wheel.js"></script>
    <script src="/js/spotify.js"></script>
    <script src="/js/playlists.js"></script>
    <script src="/js/playlist-picker.js"></script>
    <script src="/js/song-playlists.js"></script>
    <script src="/js/confirm-dialog.js"></script>
    <script src="/js/settings.js"></script>
  </body>
</html>
