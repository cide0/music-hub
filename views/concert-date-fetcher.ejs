<!DOCTYPE html>
<html lang="en" class="is-logged-out">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/navbar') %>

    <main class="page">
      <div class="page__header">
        <h1 class="page__title"><%= pageTitle %></h1>
        <p class="page__countdown" id="next-attending" data-auth-required hidden></p>
        <!-- Totals over the "Last fetched" time, together no taller than the title. -->
        <div class="page__meta" data-auth-required>
          <p class="page__summary" id="concerts-summary" hidden></p>
          <p class="page__summary" id="last-fetched" hidden></p>
        </div>
      </div>

      <!-- Shown once a valid Spotify login is present. -->
      <section class="page__content" data-auth-required>
        <div class="toolbar">
          <button type="button" class="icon-button refresh-button" id="fetch-concerts" aria-label="Fetch concert dates" title="Fetch concert dates">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="23 4 23 10 17 10" /><polyline points="1 20 1 14 7 14" />
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
            </svg>
          </button>
          <button type="button" class="icon-button clear-button" id="clear-concerts" aria-label="Clear saved data" title="Clear saved data" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" />
            </svg>
          </button>
          <%# The user's bought tickets on each shop, in a new tab. Ticketmaster's
              site follows the cities' country (concert-date-fetcher.js). %>
          <a class="icon-button shop-button shop-button--ticketmaster" id="ticketmaster-tickets"
            href="https://www.ticketmaster.de/user/orders" target="_blank" rel="noopener noreferrer"
            aria-label="My tickets on Ticketmaster" title="My tickets on Ticketmaster">
            <svg viewBox="-5.6 0.6 20 20" aria-hidden="true">
              <path class="shop-button__mark" d="M4.19 15.35c0-.47.07-.9.14-1.18l1.16-5.3h2.86l.5-2.32H5.99l.79-3.61-3.43 1.1-.54 2.5H.5L0 8.87h2.3l-.9 4.11c-.21.97-.4 1.89-.4 2.83C1 18.14 2.52 19 4.69 19c.54 0 1.16-.18 1.7-.3l.56-2.45a4.27 4.27 0 0 1-1.55.28c-.71 0-1.22-.44-1.22-1.18z" />
            </svg>
          </a>
          <a class="icon-button shop-button shop-button--eventim" id="eventim-tickets"
            href="https://www.eventim.de/dashboard/my-events" target="_blank" rel="noopener noreferrer"
            aria-label="My tickets on Eventim" title="My tickets on Eventim">
            <svg viewBox="302.35 -2.25 64 64" aria-hidden="true">
              <path class="shop-button__star" d="M327.2,36.9L327.2,36.9c6.2,6.2,6.4,15.9,6.4,22.6h1.5c0-6.7,0.2-16.4,6.4-22.6l0,0 c6.2-6.2,15.9-6.4,22.6-6.4V29c-6.7,0-16.4-0.2-22.6-6.4l0,0c-6.2-6.2-6.4-15.9-6.4-22.6h-1.6c0,6.7-0.2,16.4-6.4,22.6l0,0 c-6.2,6.2-15.9,6.4-22.6,6.4v1.5C311.3,30.5,321,30.7,327.2,36.9z" />
            </svg>
          </a>

          <div class="toolbar__end concert-controls" id="concert-controls" hidden>
            <div class="concert-search">
              <label class="visually-hidden" for="concert-search">Search concerts</label>
              <div class="input-clear">
                <input type="text" id="concert-search" class="text-input" placeholder="Search"
                  autocomplete="off" spellcheck="false" />
                <button type="button" class="input-clear__button" id="concert-search-clear" aria-label="Clear search" hidden>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                  </svg>
                </button>
              </div>
            </div>

            <div class="filter-group" id="concert-filters" role="group" aria-label="Filter concerts">
              <button type="button" class="filter-button filter-button--active" data-filter="all" aria-pressed="true">All</button>
              <button type="button" class="filter-button" data-filter="attending" aria-pressed="false">I&rsquo;m attending</button>
              <button type="button" class="filter-button" data-filter="new" aria-pressed="false" disabled>New</button>
            </div>
          </div>
        </div>

        <div class="status-bar" id="fetch-status" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden>
          <div class="status-bar__fill" id="fetch-progress"></div>
          <span class="status-bar__text" id="fetch-status-text"></span>
          <span class="status-bar__eta" id="fetch-eta"></span>
          <button type="button" class="status-bar__cancel" id="fetch-cancel" aria-label="Cancel fetching">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>

        <!-- What the last fetch added, or why it couldn't run; fades out on its own. -->
        <div class="notice" id="fetch-toast" role="status" hidden></div>

        <div class="notice" id="failed-notice" hidden>
          <span class="notice__text" id="failed-text"></span>
          <button type="button" class="button button--ghost notice__action" id="failed-retry">Retry</button>
          <button type="button" class="notice__dismiss" id="failed-dismiss" aria-label="Dismiss">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>

        <p class="empty-state" id="concerts-message" hidden></p>
        <div class="concert-grid" id="concerts-list"></div>
      </section>

      <!-- Page-level gating: no Spotify login, no page content. -->
      <section class="empty-state" data-auth-missing>
        <p>Please log in to Spotify first</p>
      </section>
    </main>

    <script src="/js/notice.js"></script>
    <script src="/js/storage.js"></script>
    <script src="/js/google.js"></script>
    <script src="/js/sync.js"></script>
    <script src="/js/navbar.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/followed-artists.js"></script>
    <script src="/js/wallet.js"></script>
    <script src="/js/vinyl.js"></script>
    <script src="/js/vinyl-catalog.js"></script>
    <script src="/js/sfx.js"></script>
    <script src="/js/unbox.js"></script>
    <script src="/js/daily-wheel.js"></script>
    <script src="/js/spotify.js"></script>
    <script src="/js/progress.js"></script>
    <script src="/js/confirm-dialog.js"></script>
    <script src="/js/concert-cities.js"></script>
    <script src="/js/concert-date-fetcher.js"></script>
  </body>
</html>
