<!DOCTYPE html>
<html lang="en" class="is-logged-out">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/navbar') %>

    <main class="page">
      <!-- Shown once a valid Spotify login is present. -->
      <section class="page__content" data-auth-required>
        <div id="collection-view">
          <div class="section-header section-header--first">
            <h2 class="section-title">Your vinyl collection</h2>
            <span class="toolbar__meta" id="collection-count"></span>
          </div>

          <!-- Search on the left; the date sort and the filter tabs on the
               right, the tabs at the far end where the other pages keep their
               filters - once there's a vinyl. -->
          <div class="toolbar" id="collection-toolbar" hidden>
            <div class="collection-search">
              <label class="visually-hidden" for="collection-search">Search your vinyls</label>
              <div class="input-clear">
                <input type="text" id="collection-search" class="text-input" placeholder="Search style, album or artist"
                  autocomplete="off" spellcheck="false" />
                <button type="button" class="input-clear__button" id="collection-search-clear" aria-label="Clear search" hidden>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                  </svg>
                </button>
              </div>
            </div>
            <div class="toolbar__end">
              <!-- One sort; clicking it flips the direction. -->
              <div class="filter-group" id="collection-sort" role="group" aria-label="Sort vinyls">
                <button type="button" class="filter-button filter-button--active" id="collection-sort-date" aria-pressed="true">Date ↓</button>
              </div>
              <div class="filter-group" id="collection-filters" role="group" aria-label="Filter vinyls">
                <button type="button" class="filter-button filter-button--active" data-filter="all" aria-pressed="true">All</button>
                <button type="button" class="filter-button" data-filter="exclusive" aria-pressed="false" disabled>Exclusives</button>
              </div>
            </div>
          </div>

          <div class="empty-state" id="collection-empty" hidden>
            <p>Unbox your first vinyl in the <a class="page-link" href="/store">Store</a></p>
          </div>
          <p class="empty-state" id="collection-no-match" hidden></p>
          <div class="release-grid" id="collection-grid"></div>
        </div>

        <!-- Play: the collection makes way for a turntable, the vinyl dropped
             onto it and spinning while its album plays on Spotify. -->
        <div class="player" id="player" hidden>
          <div class="player__bar">
            <button type="button" class="button button--ghost player__back" id="player-back">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18">
                <line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" />
              </svg>
              Back to collection
            </button>
            <a class="icon-button player__discogs" id="player-discogs" href="#" target="_blank" rel="noopener noreferrer" aria-label="Find vinyl on Discogs (opens in a new tab)" title="Find vinyl on Discogs">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            </a>
          </div>
          <!-- The turntable, with what's playing in its top-left corner -
               the album, its artist and the track Spotify is on - and the
               track's place in the album ("5/20") in the top-right one. -->
          <div class="player__deck" id="player-deck">
            <div class="player__now">
              <h2 class="player__title" id="player-title"></h2>
              <p class="player__artist" id="player-artist"></p>
              <!-- The track, and beside it the + that puts it on playlists -
                   a heart once it's on one (see the song's playlists below). -->
              <div class="player__song" id="player-song" hidden>
                <p class="player__track" id="player-track">
                  <span class="visually-hidden" id="player-track-label"></span>
                  <span class="player__track-name" id="player-track-name" aria-hidden="true"></span>
                </p>
                <button type="button" class="icon-button player__save" id="player-save" aria-label="Add to playlists" title="Add to playlists">
                  <svg class="player__save-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                  <svg class="player__save-heart" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                  </svg>
                </button>
              </div>
            </div>
            <span class="player__count" id="player-count" hidden></span>
          </div>
          <div class="player__info">
            <p class="player__status" id="player-status" role="status"></p>
            <div class="player__actions" id="player-actions" hidden></div>
          </div>
        </div>

        <!-- The song's playlists: every playlist, ticked where the song is on it.
             Ticking one adds the song there, unticking takes it off. -->
        <dialog class="modal" id="song-playlists-dialog" aria-labelledby="song-playlists-title"
          aria-describedby="song-playlists-song">
          <button type="button" class="icon-button modal__close" data-modal-close aria-label="Close" title="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
          <form class="modal__form" id="song-playlists-form" novalidate>
            <h2 class="modal__title" id="song-playlists-title">Add to playlists</h2>
            <p class="modal__hint" id="song-playlists-song"></p>
            <label class="visually-hidden" for="song-playlists-search">Search your playlists</label>
            <div class="input-clear">
              <input type="search" id="song-playlists-search" class="text-input" placeholder="Search your playlists" autocomplete="off" />
              <button type="button" class="input-clear__button" id="song-playlists-search-clear" aria-label="Clear search" hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
                </svg>
              </button>
            </div>
            <p class="form-message" id="song-playlists-message" hidden></p>
            <ul class="playlist-checklist" id="song-playlists-list" aria-label="Your playlists"></ul>
            <p class="form-error" id="song-playlists-error" role="alert" hidden></p>
            <div class="modal__actions">
              <button type="button" class="button button--ghost" id="song-playlists-cancel">Cancel</button>
              <button type="submit" class="button button--primary" id="song-playlists-submit" disabled>No changes</button>
            </div>
          </form>
        </dialog>

        <!-- Asks before a vinyl leaves the collection (see confirmRemove). -->
        <dialog class="modal modal--confirm" id="remove-vinyl-dialog" aria-labelledby="remove-vinyl-dialog-title"
          aria-describedby="remove-vinyl-dialog-text">
          <button type="button" class="icon-button modal__close" data-modal-close aria-label="Close" title="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
          <form class="modal__form" id="remove-vinyl-form">
            <h2 class="modal__title" id="remove-vinyl-dialog-title">Remove this vinyl?</h2>
            <p class="modal__hint" id="remove-vinyl-dialog-text"></p>
            <div class="modal__actions">
              <button type="button" class="button button--ghost" id="remove-vinyl-cancel">Cancel</button>
              <button type="submit" class="button button--danger">Remove</button>
            </div>
          </form>
        </dialog>
      </section>

      <!-- Page-level gating: no Spotify login, no page content. -->
      <section class="empty-state" data-auth-missing>
        <p>Please log in to Spotify first</p>
      </section>
    </main>

    <script src="/js/notice.js"></script>
    <script src="/js/storage.js"></script>
    <script src="/js/google.js"></script>
    <script src="/js/sync.js"></script>
    <script src="/js/navbar.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/followed-artists.js"></script>
    <script src="/js/wallet.js"></script>
    <script src="/js/vinyl.js"></script>
    <script src="/js/vinyl-catalog.js"></script>
    <script src="/js/sfx.js"></script>
    <script src="/js/tear.js"></script>
    <script src="/js/unbox.js"></script>
    <script src="/js/daily-wheel.js"></script>
    <script src="/js/confirm-dialog.js"></script>
    <script src="/js/spotify.js"></script>
    <script src="/js/playlists.js"></script>
    <script src="/js/playlist-picker.js"></script>
    <script src="/js/song-playlists.js"></script>
    <script src="/js/turntable.js"></script>
    <script src="/js/collection.js"></script>
  </body>
</html>
