<!DOCTYPE html>
<html lang="en" class="is-logged-out">
  <head>
    <%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/navbar') %>

    <main class="page">
      <!-- Shown once a valid Spotify login is present. -->
      <section class="page__content" data-auth-required>
        <!-- The Drive folder the gallery fills itself from (concert-history.js). -->
        <div class="notice gallery-drive" id="gallery-drive" hidden>
          <div class="notice__text gallery-drive__body">
            <p class="gallery-drive__status" id="gallery-drive-status" role="status"></p>
            <p class="form-message gallery-drive__note" id="gallery-drive-unmatched" hidden></p>
            <p class="form-message gallery-drive__note" id="gallery-drive-share" hidden></p>
          </div>
          <div class="gallery-drive__actions">
            <!-- What this level has hidden of the Drive folder (renderUnhideButton). -->
            <button type="button" class="button button--ghost notice__action" id="gallery-unhide" hidden></button>
            <button type="button" class="icon-button refresh-button" id="gallery-drive-sync" aria-label="Sync with Google Drive" title="Sync with Google Drive" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="23 4 23 10 17 10" /><polyline points="1 20 1 14 7 14" />
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
              </svg>
            </button>
          </div>
        </div>

        <nav class="breadcrumb" id="breadcrumb" aria-label="Breadcrumb"></nav>

        <!-- Level 1: artist folders -->
        <section id="view-artists">
          <div class="folder-grid" id="artists-grid">
            <!-- Always the first card: renderArtists keeps it and rebuilds the rest. -->
            <div class="folder-card folder-card--add folder-card--add-artist" id="add-artist">
              <svg class="folder-card__dashes" aria-hidden="true"><rect width="100%" height="100%" rx="12" /></svg>
              <button type="button" class="folder-card__open" id="add-artist-toggle"
                aria-expanded="false" aria-controls="add-artist-panel">
                <svg class="folder-card__icon folder-card__icon--add" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                  <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                <span class="folder-card__name">Add artist</span>
                <span class="folder-card__meta">From the artists you follow</span>
              </button>

              <div class="add-panel" id="add-artist-panel" hidden>
                <label class="visually-hidden" for="artist-search">Search your followed artists</label>
                <input type="search" id="artist-search" class="text-input" placeholder="Search your followed artists" autocomplete="off" />
                <p class="form-message" id="artist-picker-message" hidden></p>
                <ul class="picker" id="artist-picker"></ul>
              </div>
            </div>
          </div>
        </section>

        <!-- Everything hearted, across every artist and concert -->
        <section id="view-favorites" hidden>
          <p class="empty-state" id="favorites-empty" hidden></p>
          <div id="favorites-list"></div>
        </section>

        <!-- Level 2: concert subfolders -->
        <section id="view-concerts" hidden>
          <ul class="folder-grid folder-grid--tiles" id="concerts-list">
            <!-- Always the first tile: renderConcerts keeps it and rebuilds the rest. -->
            <li class="folder-card folder-card--concert folder-card--add" id="add-concert-tile">
              <button type="button" class="folder-card__open" id="add-concert">
                <svg class="folder-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                  <line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                <span class="folder-card__name">Add concert</span>
              </button>
            </li>
          </ul>
        </section>

        <!-- Level 3: the images and videos of one concert -->
        <section id="view-media" hidden>
          <div class="toolbar">
            <button type="button" class="button button--primary" id="add-media">+ Add media</button>

            <div class="toolbar__end">
              <!-- Sorted by the date an item was added; clicking flips the direction,
                   like the Album Suggester's history sort. -->
              <div class="filter-group" role="group" aria-label="Sort media">
                <button type="button" class="filter-button filter-button--active" id="media-order" aria-pressed="true">Date ↓</button>
              </div>

              <div class="filter-group" id="media-filters" role="group" aria-label="Filter media">
                <button type="button" class="filter-button filter-button--active" data-media-filter="all" aria-pressed="true">All</button>
                <button type="button" class="filter-button" data-media-filter="favorites" aria-pressed="false">Favorites</button>
              </div>
            </div>
          </div>

          <p class="empty-state" id="media-note" hidden></p>

          <div id="images-section" hidden>
            <h2 class="section-title">Images</h2>
            <div class="media-grid" id="images-grid"></div>
          </div>

          <div id="videos-section" hidden>
            <h2 class="section-title">Videos</h2>
            <div class="media-list" id="videos-list"></div>
          </div>
        </section>

        <dialog class="modal" id="concert-dialog">
          <button type="button" class="icon-button modal__close" data-modal-close aria-label="Close" title="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
          <form class="modal__form" id="concert-form">
            <h2 class="modal__title" id="concert-dialog-title">Add concert</h2>
            <label class="visually-hidden" for="concert-name-input">Concert folder name</label>
            <input type="text" id="concert-name-input" class="text-input" placeholder="Concert folder name" required />
            <p class="form-error" id="concert-name-error" hidden></p>
            <div class="modal__actions">
              <button type="button" class="button button--ghost" id="concert-cancel">Cancel</button>
              <button type="submit" class="button button--primary" id="concert-submit">Add</button>
            </div>
          </form>
        </dialog>

        <!-- Asks before anything is removed; filled in by confirmRemoval(). -->
        <dialog class="modal modal--confirm" id="confirm-dialog" aria-labelledby="confirm-dialog-title"
          aria-describedby="confirm-dialog-text">
          <button type="button" class="icon-button modal__close" data-modal-close aria-label="Close" title="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
          <form class="modal__form" id="confirm-form">
            <h2 class="modal__title" id="confirm-dialog-title">Delete?</h2>
            <p class="modal__hint" id="confirm-dialog-text"></p>
            <div class="modal__actions">
              <button type="button" class="button button--ghost" id="confirm-cancel">Cancel</button>
              <button type="submit" class="button button--danger" id="confirm-submit">Delete</button>
            </div>
          </form>
        </dialog>

        <!-- Touch screens: an image opened large from its card, where Drive's
             viewer can pan and zoom without getting in the way of scrolling
             the page (concert-history.js openViewer). -->
        <dialog class="modal media-viewer" id="media-viewer" aria-label="Image from Google Drive">
          <button type="button" class="icon-button modal__close" data-modal-close aria-label="Close" title="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
          <div class="media-viewer__frame" id="media-viewer-frame"></div>
        </dialog>

        <dialog class="modal" id="media-dialog">
          <button type="button" class="icon-button modal__close" data-modal-close aria-label="Close" title="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
          <form class="modal__form" id="media-form">
            <h2 class="modal__title" id="media-dialog-title">Add media</h2>
            <p class="modal__hint">
              Paste Google Drive share links or embed codes — one per line. Both formats work, mixed.
            </p>
            <label class="switch">
              <input type="checkbox" id="media-is-video" checked />
              <span class="switch__track"><span class="switch__thumb"></span></span>
              <span class="switch__label">Videos</span>
            </label>
            <label class="visually-hidden" for="media-input">Google Drive links or embed codes</label>
            <textarea id="media-input" class="text-input" rows="6"
              placeholder="https://drive.google.com/file/d/FILE_ID/view&#10;&lt;iframe src=&quot;https://drive.google.com/file/d/FILE_ID/preview&quot;&gt;&lt;/iframe&gt;"></textarea>
            <p class="form-error" id="media-error" hidden></p>
            <div class="modal__actions">
              <button type="button" class="button button--ghost" id="media-cancel">Cancel</button>
              <button type="submit" class="button button--primary" id="media-submit">Add</button>
            </div>
          </form>
        </dialog>
      </section>

      <!-- Page-level gating: no Spotify login, no page content. -->
      <section class="empty-state" data-auth-missing>
        <p>Please log in to Spotify first</p>
      </section>
    </main>

    <script src="/js/notice.js"></script>
    <script src="/js/storage.js"></script>
    <script src="/js/google.js"></script>
    <script src="/js/sync.js"></script>
    <script src="/js/navbar.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/followed-artists.js"></script>
    <script src="/js/wallet.js"></script>
    <script src="/js/vinyl.js"></script>
    <script src="/js/vinyl-catalog.js"></script>
    <script src="/js/sfx.js"></script>
    <script src="/js/unbox.js"></script>
    <script src="/js/daily-wheel.js"></script>
    <script src="/js/confirm-dialog.js"></script>
    <script src="/js/spotify.js"></script>
    <script src="/js/concert-history.js"></script>
  </body>
</html>
