<script>
  /*
   * Runs before the page paints, so a logged-in user never sees the
   * "please log in" state flash by. It only sets a class on <html>;
   * public/js/auth.js keeps that class up to date afterwards.
   * The key must stay in sync with AUTH_KEY in public/js/auth.js.
   */
  (function () {
    var loggedIn = false;
    try {
      var raw = localStorage.getItem('spotifyAuth');
      loggedIn = !!(raw && JSON.parse(raw).accessToken);
    } catch (err) {
      loggedIn = false;
    }
    var root = document.documentElement;
    root.classList.toggle('is-logged-in', loggedIn);
    root.classList.toggle('is-logged-out', !loggedIn);

    /*
     * The styles bought in the Store - the profile pill's name style, the
     * navbar's style and the Collection's record player's - from the first
     * paint too. Must stay
     * in sync with STORE_KEY, STYLE_ATTRIBUTES and the owned ids in
     * public/js/wallet.js.
     */
    try {
      var store = JSON.parse(localStorage.getItem('store') || 'null');
      var slots = { username: 'data-name-style', navbar: 'data-navbar-style', player: 'data-player-style' };
      Object.keys(slots).forEach(function (slot) {
        var style = store && store.equipped && store.equipped[slot];
        if (style && Array.isArray(store.owned) && store.owned.indexOf(slot + ':' + style) !== -1) {
          root.setAttribute(slots[slot], style);
        }
      });
    } catch (err) {
      // No styles, then.
    }

    /*
     * With the Google Drive sync on, the page stays hidden ("Syncing with
     * Google Drive...") until public/js/sync.js has fetched what's newer on
     * Drive - see `holding` there. Not right after a reload that sync made:
     * that page already has the new data. Must stay in sync with sync.js's
     * STATE_KEY and RELOADED_FLAG, and with google.js's AUTH_KEY and
     * DRIVE_SCOPE.
     */
    try {
      var syncAvailable = <%- driveSync ? 'true' : 'false' %>;
      var syncState = JSON.parse(localStorage.getItem('syncState') || 'null');
      var googleAuth = JSON.parse(localStorage.getItem('googleAuth') || 'null');
      var driveAccess = !!(googleAuth && googleAuth.accessToken && typeof googleAuth.scope === 'string'
        && googleAuth.scope.split(' ').indexOf('https://www.googleapis.com/auth/drive.appdata') !== -1);
      if (syncAvailable && syncState && syncState.enabled === true && driveAccess
        && sessionStorage.getItem('musichub:syncReloaded') !== '1') {
        root.classList.add('is-sync-loading');
      }
    } catch (err) {
      // No waiting for Drive, then.
    }
  })();
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Read by public/js/sync.js: "off" in local development. -->
<meta name="musichub-drive-sync" content="<%= driveSync ? 'on' : 'off' %>" />
<title><%= pageTitle %> · Music Hub</title>
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="stylesheet" href="/css/style.css" />
