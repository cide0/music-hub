<script>
  /*
   * Runs before the page paints, so a logged-in user never sees the
   * "please log in" state flash by. It only sets a class on <html>;
   * public/js/auth.js keeps that class up to date afterwards.
   * The key must stay in sync with AUTH_KEY in public/js/auth.js.
   */
  (function () {
    var loggedIn = false;
    try {
      var raw = localStorage.getItem('spotifyAuth');
      loggedIn = !!(raw && JSON.parse(raw).accessToken);
    } catch (err) {
      loggedIn = false;
    }
    var root = document.documentElement;
    root.classList.toggle('is-logged-in', loggedIn);
    root.classList.toggle('is-logged-out', !loggedIn);

    /*
     * The styles bought in the Store - the profile pill's name style and
     * the navbar's style - on the navbar from the first paint too. Must stay
     * in sync with STORE_KEY, STYLE_ATTRIBUTES and the owned ids in
     * public/js/wallet.js.
     */
    try {
      var store = JSON.parse(localStorage.getItem('store') || 'null');
      var slots = { username: 'data-name-style', navbar: 'data-navbar-style' };
      Object.keys(slots).forEach(function (slot) {
        var style = store && store.equipped && store.equipped[slot];
        if (style && Array.isArray(store.owned) && store.owned.indexOf(slot + ':' + style) !== -1) {
          root.setAttribute(slots[slot], style);
        }
      });
    } catch (err) {
      // No styles, then.
    }
  })();
</script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= pageTitle %> · Music Hub</title>
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="stylesheet" href="/css/style.css" />
