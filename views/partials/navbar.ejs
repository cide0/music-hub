<header class="navbar">
  <div class="navbar__bar">
    <button
      type="button"
      class="icon-button navbar__toggle"
      id="navbar-toggle"
      aria-controls="navbar-tabs"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>

    <a class="navbar__brand" href="/">
      <img src="/favicon.png" alt="" /><span class="navbar__label">Music Hub</span>
    </a>

    <nav class="navbar__tabs" id="navbar-tabs" aria-label="Pages">
      <% tabs.filter(function (tab) { return !tab.external; }).forEach(function (tab) { %>
        <a
          class="navbar__tab<%= tab.href === activePath ? ' navbar__tab--active' : '' %>"
          href="<%= tab.href %>"
          <%- tab.href === activePath ? 'aria-current="page"' : '' %>
        ><span class="navbar__label"><%= tab.label %></span><% if (tab.coins) { %>
          <span class="coin-balance" title="Your coins">
            <svg class="coin" data-coin-target aria-hidden="true"><use href="#coin-icon" /></svg>
            <span class="coin-balance__value" data-coin-balance>0</span><span class="visually-hidden"> coins</span>
          </span><% } %></a>
      <% }); %>

      <% var externalTabs = tabs.filter(function (tab) { return tab.external; }); %>
      <% if (externalTabs.length) { %>
        <div class="navbar__dropdown" id="external-tools">
          <button
            type="button"
            class="navbar__tab navbar__dropdown-toggle"
            id="external-tools-toggle"
            aria-controls="external-tools-menu"
            aria-expanded="false"
          >
            <span class="navbar__label">External Tools</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
          <ul class="navbar__menu" id="external-tools-menu" hidden>
            <% externalTabs.forEach(function (tab) { %>
              <li>
                <a class="navbar__menu-item" href="<%= tab.href %>" target="_blank" rel="noopener noreferrer">
                  <span class="navbar__label"><%= tab.label %></span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                </a>
              </li>
            <% }); %>
          </ul>
        </div>
      <% } %>
    </nav>

    <div class="navbar__actions">
      <!-- The coin balance for phones, where the Store tab is folded away in
           the hamburger menu. Hidden on wider screens. -->
      <a class="coin-balance navbar__coins" href="/store" title="Your coins - open the Store">
        <svg class="coin" data-coin-target aria-hidden="true"><use href="#coin-icon" /></svg>
        <span class="coin-balance__value" data-coin-balance>0</span><span class="visually-hidden"> coins</span>
      </a>

      <a class="button button--primary navbar__login" id="spotify-login" data-auth-missing href="/login" title="Login with Spotify">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="20" height="20">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" />
        </svg>
        <span class="navbar__login-label">Login with Spotify</span>
      </a>

      <a class="navbar__user" id="spotify-user" data-auth-required href="#" title="Open your profile in Spotify">
        <img class="navbar__avatar" id="spotify-avatar" src="" alt="" />
        <span id="spotify-user-name"></span>
      </a>

      <!-- Fetches the followed Spotify artists that every page reads from
           localStorage - see followed-artists.js. -->
      <button type="button" class="icon-button refresh-button navbar__refresh" id="followed-refresh" data-auth-required
        aria-label="Refresh followed artists" title="Refresh followed artists">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="23 4 23 10 17 10" /><polyline points="1 20 1 14 7 14" />
          <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
        </svg>
      </button>

      <a
        class="icon-button navbar__settings<%= activePath === '/settings' ? ' navbar__settings--active' : '' %>"
        href="/settings"
        title="Settings"
        aria-label="Settings"
        <%- activePath === '/settings' ? 'aria-current="page"' : '' %>
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
      </a>
    </div>
  </div>
  <!-- How the navbar's followed-artists refresh went. -->
  <p class="navbar__toast" id="followed-toast" role="status" hidden></p>
</header>

<!-- The coin: gold, with a quaver pressed into its face. Drawn once and used
     everywhere (<use href="#coin-icon">) - the navbar, the Store, the coins
     flying up to the balance. Not display:none, which would drop the
     gradients. -->
<svg class="svg-sprite" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="coin-rim-gradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="coin-stop--bright" />
      <stop offset="0.5" class="coin-stop--face" />
      <stop offset="1" class="coin-stop--rim" />
    </linearGradient>
    <linearGradient id="coin-face-gradient" x1="0.2" y1="0" x2="0.8" y2="1">
      <stop offset="0" class="coin-stop--shine" />
      <stop offset="0.45" class="coin-stop--bright" />
      <stop offset="1" class="coin-stop--face" />
    </linearGradient>
    <symbol id="coin-icon" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="11.2" fill="url(#coin-rim-gradient)" />
      <circle cx="12" cy="12" r="8.7" fill="url(#coin-face-gradient)" stroke="currentColor" stroke-width="0.9" />
      <g fill="currentColor">
        <ellipse cx="10.1" cy="15.7" rx="2.55" ry="1.95" transform="rotate(-22 10.1 15.7)" />
        <rect x="11.95" y="6.3" width="1.35" height="9.6" rx="0.5" />
        <path d="M12.6 6.3c.25 1.7 1.45 2.5 2.5 3.4 1.05.95 1.6 2.1 1.1 3.8-.15-1.35-.8-2.1-1.6-2.7-.65-.5-1.4-.8-2-1.1z" />
      </g>
    </symbol>
  </defs>
</svg>

<script>
  /* The balance straight away, rather than a 0 until wallet.js runs. */
  (function () {
    var coins = 0;
    try {
      var store = JSON.parse(localStorage.getItem('store') || 'null');
      coins = Math.max(0, Math.floor(Number(store && store.credits) || 0));
    } catch (err) {
      coins = 0;
    }
    Array.prototype.forEach.call(document.querySelectorAll('[data-coin-balance]'), function (node) {
      node.textContent = coins.toLocaleString('en-US');
    });
  })();
</script>
