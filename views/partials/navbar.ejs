<header class="navbar">
  <div class="navbar__bar">
    <button
      type="button"
      class="icon-button navbar__toggle"
      id="navbar-toggle"
      aria-controls="navbar-tabs"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>

    <a class="navbar__brand" href="/">
      <img src="/favicon.png" alt="" /><span>Music Hub</span>
    </a>

    <nav class="navbar__tabs" id="navbar-tabs" aria-label="Pages">
      <% tabs.filter(function (tab) { return !tab.external; }).forEach(function (tab) { %>
        <a
          class="navbar__tab<%= tab.href === activePath ? ' navbar__tab--active' : '' %>"
          href="<%= tab.href %>"
          <%- tab.href === activePath ? 'aria-current="page"' : '' %>
        ><%= tab.label %></a>
      <% }); %>

      <% var externalTabs = tabs.filter(function (tab) { return tab.external; }); %>
      <% if (externalTabs.length) { %>
        <div class="navbar__dropdown" id="external-tools">
          <button
            type="button"
            class="navbar__tab navbar__dropdown-toggle"
            id="external-tools-toggle"
            aria-controls="external-tools-menu"
            aria-expanded="false"
          >
            External Tools
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
          <ul class="navbar__menu" id="external-tools-menu" hidden>
            <% externalTabs.forEach(function (tab) { %>
              <li>
                <a class="navbar__menu-item" href="<%= tab.href %>" target="_blank" rel="noopener noreferrer">
                  <%= tab.label %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                </a>
              </li>
            <% }); %>
          </ul>
        </div>
      <% } %>
    </nav>

    <div class="navbar__actions">
      <a class="button button--primary navbar__login" id="spotify-login" data-auth-missing href="/login" title="Login with Spotify">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="20" height="20">
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" y1="12" x2="3" y2="12" />
        </svg>
        <span class="navbar__login-label">Login with Spotify</span>
      </a>

      <a class="navbar__user" id="spotify-user" data-auth-required href="#" title="Open your profile in Spotify">
        <img class="navbar__avatar" id="spotify-avatar" src="" alt="" />
        <span id="spotify-user-name"></span>
      </a>

      <a
        class="icon-button navbar__settings<%= activePath === '/settings' ? ' navbar__settings--active' : '' %>"
        href="/settings"
        title="Settings"
        aria-label="Settings"
        <%- activePath === '/settings' ? 'aria-current="page"' : '' %>
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
      </a>
    </div>
  </div>
</header>
